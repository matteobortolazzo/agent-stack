{
  "configVersion": "1.1.0",
  "branchPattern": "feature/<id>-<description>",
  "isMonorepo": true,
  "stack": {
    "backend": "go1.25",
    "testing": [
      "go-testing",
      "shellcheck"
    ]
  },
  "projects": [
    {
      "slug": "flow",
      "path": "flow",
      "name": "flow",
      "description": "Claude Code plugin: markdown skills, agents, shell hooks",
      "stack": {
        "framework": "markdown-shell"
      },
      "buildCommand": "",
      "testCommand": "",
      "gateCommand": "bash scripts/run-checks.sh",
      "automerge": {
        "protectedPaths": [
          "flow/agents/",
          "flow/skills/",
          "flow/hooks/",
          "flow/codex/",
          "flow/opencode/",
          "flow/scripts/",
          "flow/templates/",
          "flow/.claude-plugin/",
          "flow/.codex-plugin/",
          "flow/AGENTS.md",
          "flow/CLAUDE.md",
          "*credential*",
          "*secret*"
        ],
        "maxChangedFiles": 8,
        "maxDiffLines": 400,
        "mergeMethod": "squash"
      }
    },
    {
      "slug": "watch",
      "path": "watch",
      "name": "watch",
      "description": "Go binary + Claude Code plugin: coding-agent session monitoring (tmux, waybar, noctalia, DMS)",
      "stack": {
        "framework": "go1.25",
        "testing": "go-testing"
      },
      "buildCommand": "make build",
      "testCommand": "make test",
      "lintCommand": "make lint",
      "gateCommand": "make test",
      "serveCommand": "go run .",
      "boardKey": "R w",
      "testKey": "T w",
      "automerge": {
        "protectedPaths": [
          "watch/internal/",
          "watch/pkg/",
          "watch/plugin/",
          "watch/plugin/.claude-plugin/",
          "watch/plugin/.codex-plugin/",
          "watch/main.go",
          "watch/*_cmd.go",
          "watch/cli_helpers.go",
          "watch/go.mod",
          "watch/go.sum",
          "watch/Makefile",
          "watch/.goreleaser.yml",
          "watch/AGENTS.md",
          "watch/CLAUDE.md",
          "*credential*",
          "*secret*"
        ],
        "maxChangedFiles": 10,
        "maxDiffLines": 500,
        "mergeMethod": "squash"
      }
    },
    {
      "slug": "sandbox",
      "path": "sandbox",
      "name": "sandbox",
      "description": "Docker/Podman container for isolated Claude Code sessions",
      "stack": {
        "framework": "docker-shell",
        "testing": "shellcheck"
      },
      "buildCommand": "docker build",
      "testCommand": "",
      "gateCommand": "n=0; for t in tests/*.test.sh; do [ \"$t\" = tests/smoke.test.sh ] && continue; bash \"$t\" || exit 1; n=$((n+1)); done; [ \"$n\" -gt 0 ] || exit 1",
      "automerge": {
        "protectedPaths": [
          "sandbox/Dockerfile*",
          "sandbox/entrypoint.sh",
          "sandbox/fragments/",
          "sandbox/lib/",
          "sandbox/skills/",
          "sandbox/.claude-plugin/",
          "sandbox/.codex-plugin/",
          "sandbox/AGENTS.md",
          "sandbox/CLAUDE.md",
          "*credential*",
          "*secret*"
        ],
        "maxChangedFiles": 8,
        "maxDiffLines": 400,
        "mergeMethod": "squash"
      }
    }
  ],
  "planning": {
    "autonomy": "interactive"
  },
  "guidanceLocation": "AGENTS.md",
  "mcpServers": {
    "context7": true
  },
  "lspServers": {
    "gopls": true,
    "pyright": true
  },
  "autoCompactDisabled": true,
  "pinSubagents200K": false,
  "sandbox": {
    "enabled": true
  },
  "lazyboards": {
    "enabled": true
  },
  "maintenance": {
    "enabled": true,
    "checkDuringImplement": true,
    "remindAfterDays": 30,
    "generatedDocs": true
  },
  "cenci": {
    "diffContextMode": "file"
  }
}
